#!/usr/bin/env python3
import json
import os
import subprocess
import sys
import fcntl

# Single instance lock
lock_file = open(f"/tmp/omdrop-tray-{os.getuid()}.lock", "w")
try:
    fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
except IOError:
    sys.exit(0)

# Ensure ~/.local/bin is in PATH
local_bin = os.path.expanduser("~/.local/bin")
if local_bin not in os.environ.get("PATH", ""):
    os.environ["PATH"] = local_bin + ":" + os.environ.get("PATH", "")

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import Gtk, GLib, AyatanaAppIndicator3

class OmdropTray:
    def __init__(self):
        self.icon_dir = os.path.expanduser("~/.local/share/icons")
        self.static_icon = "omdrop-radio.svg"
        self.anim_frames = [
            "omdrop-radio-anim-1.svg",
            "omdrop-radio-anim-2.svg",
            "omdrop-radio-anim-3.svg",
        ]
        self.frame_idx = 0
        self.anim_timer = None
        self.download_dir = os.path.expanduser("~/Downloads/omdrop")

        # Ensure download directory exists
        os.makedirs(self.download_dir, exist_ok=True)

        self.indicator = AyatanaAppIndicator3.Indicator.new_with_path(
            "omdrop-tray",
            self.static_icon,
            AyatanaAppIndicator3.IndicatorCategory.APPLICATION_STATUS,
            self.icon_dir,
        )
        self.indicator.set_status(AyatanaAppIndicator3.IndicatorStatus.ACTIVE)
        self.menu = Gtk.Menu()
        self.indicator.set_menu(self.menu)

        self.status_item = Gtk.MenuItem(label="Omdrop: Loading...")
        self.status_item.set_sensitive(False)
        self.menu.append(self.status_item)

        self.menu.append(Gtk.SeparatorMenuItem())

        self.btn_on = Gtk.MenuItem(label="Turn On (10 Minutes)")
        self.btn_on.connect("activate", lambda _: self.run_cmd(["omdrop", "on", "10m"]))
        self.menu.append(self.btn_on)

        self.btn_off = Gtk.MenuItem(label="Turn Off")
        self.btn_off.connect("activate", lambda _: self.run_cmd(["omdrop", "off"]))
        self.menu.append(self.btn_off)

        self.menu.append(Gtk.SeparatorMenuItem())

        self.btn_send = Gtk.MenuItem(label="Send Files...")
        self.btn_send.connect("activate", self.on_send)
        self.menu.append(self.btn_send)

        self.btn_open_dl = Gtk.MenuItem(label="Open Received Folder")
        self.btn_open_dl.connect("activate", lambda _: subprocess.Popen(["thunar", self.download_dir]))
        self.menu.append(self.btn_open_dl)

        self.menu.append(Gtk.SeparatorMenuItem())

        btn_quit = Gtk.MenuItem(label="Quit Tray")
        btn_quit.connect("activate", lambda _: Gtk.main_quit())
        self.menu.append(btn_quit)

        self.menu.show_all()

        GLib.timeout_add_seconds(2, self.refresh_status)
        self.refresh_status()

    def run_cmd(self, args):
        subprocess.Popen(args)
        GLib.timeout_add(500, self.refresh_status)

    def on_send(self, _):
        res = subprocess.run(["zenity", "--file-selection", "--title=Select Files for AirDrop"], capture_output=True, text=True)
        if res.returncode == 0 and res.stdout.strip():
            filepath = res.stdout.strip()
            subprocess.Popen(["omdrop", "send", filepath])

    def start_animation(self):
        if self.anim_timer is None:
            self.frame_idx = 0
            self.anim_timer = GLib.timeout_add(400, self._step_animation)

    def stop_animation(self):
        if self.anim_timer is not None:
            GLib.source_remove(self.anim_timer)
            self.anim_timer = None
            self.indicator.set_icon_full(self.static_icon, "Omdrop")

    def _step_animation(self):
        frame = self.anim_frames[self.frame_idx]
        self.indicator.set_icon_full(frame, "Omdrop Active")
        self.frame_idx = (self.frame_idx + 1) % len(self.anim_frames)
        return True

    def refresh_status(self):
        try:
            res = subprocess.run(["omdrop", "status", "--json"], capture_output=True, text=True, timeout=2)
            if res.returncode == 0:
                data = json.loads(res.stdout)
                receiving = data.get("receiving", False)
                rem = data.get("remaining")
                dir_val = data.get("dir")
                if dir_val:
                    self.download_dir = dir_val

                if receiving:
                    text = f"Omdrop: Active ({rem})" if rem else "Omdrop: Active"
                    self.status_item.set_label(text)
                    self.btn_off.set_sensitive(True)
                    self.btn_on.set_sensitive(False)
                    self.start_animation()
                else:
                    self.status_item.set_label("Omdrop: Off")
                    self.btn_off.set_sensitive(False)
                    self.btn_on.set_sensitive(True)
                    self.stop_animation()
            else:
                self.status_item.set_label("Omdrop: Error")
                self.stop_animation()
        except Exception:
            self.status_item.set_label("Omdrop: Offline")
            self.stop_animation()
        return True

if __name__ == "__main__":
    app = OmdropTray()
    Gtk.main()
